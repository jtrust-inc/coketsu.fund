---
import BaseLayout from "../layouts/BaseLayout.astro";
const page = { route:"/", file:"index.html", title:"COKETSU FUND｜少額から始める不動産クラウドファンディング", description:"COKETSU FUNDは、専門家とともに価値と未来を創造する不動産投資型クラウドファンディングです。無料資料請求・相談予約を受け付けています。", bodyClass:"lp-page image-lp", headAssets:"", beforeHeader:"", header:"", content:"", footer:"", afterFooter:"" };
const siteKey = "0x4AAAAAAFYoRD5PnpO-VDnW";
const fields = [["name","お名前","name"],["name_kana","フリガナ","off"],["email","メールアドレス","email"],["phone","電話番号","tel"],["address","ご住所","street-address"]];
---
<BaseLayout page={page}>
  <main id="main" data-astro-migrated="true">
    <div class="design-canvas">
      <img class="design-image" src="/assets/lp/1009-coketsufund-lp.png" width="762" height="2064" alt="COKETSU FUND 不動産クラウドファンディング" />
      <nav class="hotspots" aria-label="メインナビゲーション"><a class="hot logo" href="/" aria-label="COKETSU FUND ホーム"></a><a class="hot feature" href="#about">特徴</a><a class="hot mechanism" href="#mechanism">仕組み</a><a class="hot flow" href="#flow">ご利用の流れ</a><a class="hot request" href="#consultation">無料資料請求・相談予約</a></nav>
      <form id="consultation" class="overlay-form top-form" action="/api/forms/request" method="post" data-astro-form="request" aria-label="無料資料請求・相談予約">
        {fields.map(([name,label,autocomplete],index) => <label class={`field field-${index+1}`}><span class="sr-only">{label}</span><input name={name} type={name === "email" ? "email" : name === "phone" ? "tel" : "text"} autocomplete={autocomplete} placeholder=" " required={name !== "address"} /></label>)}
        <label class="consent"><input type="checkbox" name="privacy_agreed" value="同意" required /><span class="sr-only">個人情報の取り扱いに同意します</span></label><a class="privacy" href="/privacy-policy/" target="_blank" aria-label="個人情報の取り扱い"></a>
        <div class="astro-honeypot" aria-hidden="true"><label>会社URL<input type="text" name="company-url" tabindex="-1" autocomplete="off" /></label></div><div class="cf-turnstile" data-sitekey={siteKey} data-action="request" data-theme="light" data-appearance="interaction-only"></div><button type="submit" aria-label="無料で資料を請求する"></button><div id="astro-form-status-request" class="form-status" role="status" aria-live="polite"></div>
      </form>
      <form class="overlay-form bottom-form" action="/api/forms/request" method="post" data-astro-form="request" aria-label="無料資料請求・相談予約">
        {fields.map(([name,label,autocomplete],index) => <label class={`field field-${index+1}`}><span class="sr-only">{label}</span><input name={name} type={name === "email" ? "email" : name === "phone" ? "tel" : "text"} autocomplete={autocomplete} placeholder=" " required={name !== "address"} /></label>)}
        <label class="consent"><input type="checkbox" name="privacy_agreed" value="同意" required /><span class="sr-only">個人情報の取り扱いに同意します</span></label><a class="privacy" href="/privacy-policy/" target="_blank" aria-label="個人情報の取り扱い"></a>
        <div class="astro-honeypot" aria-hidden="true"><label>会社URL<input type="text" name="company-url" tabindex="-1" autocomplete="off" /></label></div><div class="cf-turnstile" data-sitekey={siteKey} data-action="request" data-theme="light" data-appearance="interaction-only"></div><button type="submit" aria-label="無料で資料を請求する"></button><div id="astro-form-status-request-bottom" class="form-status" role="status" aria-live="polite"></div>
      </form>
      <a class="hot footer-news" href="/news/">NEWS</a><a class="hot footer-faq" href="/contact/">よくある質問</a><a class="hot footer-contact" href="/contact/">お問い合わせ</a><a class="hot footer-company" href="https://jtrust-inc.jp/">運営会社</a>
      <div class="semantic-copy sr-only"><h1>不動産投資に、話せる安心を。</h1><p>仕組みもリスクも、担当者に相談して始める不動産小口投資。</p><section id="about"><h2>COKETSU FUNDとは</h2><p>少額から始める不動産クラウドファンディング。複数の投資家が共同で出資し、集まった資金で不動産を取得・運用します。</p></section><section id="mechanism"><h2>出資から運用、分配までの仕組み</h2><p>投資家からの出資で不動産を取得・運用し、賃料収入や売却益を契約内容に応じて分配します。</p></section><section><h2>不動産プロジェクト</h2><p>世田谷区深沢4丁目 土地1号プロジェクト、AZXIA BLD. 西麻布1号プロジェクト。</p></section><section><h2>運用の仕組み</h2><p>優先出資と劣後出資を用いて対象不動産を運用します。</p></section><section><h2>優先劣後出資システムの仕組み</h2><p>一定範囲の価格下落リスクを事業者の劣後出資が先に負担します。</p></section><section id="flow"><h2>ご相談から運用開始までの4ステップ</h2><p>資料請求・予約、資料確認・ご相談、契約手続き、払込み・運用開始。</p></section></div>
    </div>
  </main>
</BaseLayout>
<style>
  :global(html){scroll-behavior:smooth;background:#fff}:global(body.image-lp){margin:0;background:#fff;color:#083f76;font-family:"Noto Sans JP","Yu Gothic",Meiryo,sans-serif}:global(.image-lp *){box-sizing:border-box}.design-canvas{position:relative;width:min(100%,1200px);aspect-ratio:762/2064;margin:0 auto;background:#fff;overflow:hidden}.design-image{position:absolute;inset:0;width:100%;height:100%;display:block}.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}.hot{position:absolute;z-index:4;display:block;color:transparent!important;font-size:0;text-decoration:none}.logo{left:2.2%;top:.15%;width:28%;height:1.4%}.feature{left:59%;top:.15%;width:5%;height:1.5%}.mechanism{left:65%;top:.15%;width:5%;height:1.5%}.flow{left:71%;top:.15%;width:10%;height:1.5%}.request{left:81%;top:0;width:13%;height:1.75%}.footer-news{left:53%;top:91.1%;width:5%;height:1.2%}.footer-faq{left:59%;top:91.1%;width:9%;height:1.2%}.footer-contact{left:69%;top:91.1%;width:9%;height:1.2%}.footer-company{left:79%;top:91.1%;width:8%;height:1.2%}
  .overlay-form{position:absolute;z-index:5;margin:0;padding:0;pointer-events:none}.overlay-form .field,.overlay-form .consent,.overlay-form .privacy,.overlay-form button{position:absolute;display:block;pointer-events:auto}.overlay-form input:not([type="checkbox"]){width:100%;height:100%;border:0;background:transparent;padding:0 .55em;color:#1f2f3d;font:500 clamp(7px,1vw,14px)/1.2 "Noto Sans JP","Yu Gothic",sans-serif;outline:0}.overlay-form input:not([type="checkbox"]):focus{background:#ffffffdf;box-shadow:0 0 0 2px #168ee5}.overlay-form button{border:0;background:transparent;cursor:pointer}.overlay-form button:focus-visible,.hot:focus-visible,.privacy:focus-visible{outline:3px solid #ffb400;outline-offset:1px}.overlay-form .consent input{width:100%;height:100%;margin:0;accent-color:#087eea}.astro-honeypot{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}.cf-turnstile{position:absolute;left:-9999px;top:0}.form-status{position:absolute;color:#b00020;background:#fff;font-size:clamp(6px,.8vw,12px);line-height:1.2;max-width:95%}
  .top-form{left:0;top:0;width:100%;height:17.1%}.top-form .field{left:67.2%;width:26.2%;height:7.5%}.top-form .field-1{top:25.7%}.top-form .field-2{top:34.8%}.top-form .field-3{top:43.9%}.top-form .field-4{top:53%}.top-form .field-5{top:62.1%}.top-form .consent{left:61.8%;top:73.9%;width:1.8%;height:4.2%}.top-form .privacy{left:65.5%;top:79.3%;width:21%;height:4%}.top-form button{left:55.8%;top:86.4%;width:37.5%;height:10.2%}.top-form .form-status{left:56%;top:96%}
  .bottom-form{left:0;top:81.7%;width:100%;height:8.2%}.bottom-form .field{height:14.7%}.bottom-form .field-1{left:46.5%;top:24%;width:17.2%}.bottom-form .field-2{left:75%;top:24%;width:18%}.bottom-form .field-3{left:46.5%;top:43.5%;width:17.2%}.bottom-form .field-4{left:75%;top:43.5%;width:18%}.bottom-form .field-5{left:46.5%;top:63%;width:46.5%}.bottom-form .consent{left:39.3%;top:79%;width:1.7%;height:8.5%}.bottom-form .privacy{left:43%;top:86%;width:18%;height:7%}.bottom-form button{left:64.4%;top:78.2%;width:28.6%;height:17.8%}.bottom-form .form-status{left:39%;top:94%}
  .overlay-form input:not([type="checkbox"]):not(:placeholder-shown){background:#fff}.top-form .cf-turnstile{left:55%;top:67%;transform:scale(.7);transform-origin:left top}.bottom-form .cf-turnstile{left:45%;top:47%;transform:scale(.55);transform-origin:left top}
  @media(max-width:600px){.design-canvas{width:100%}.overlay-form input:not([type="checkbox"]){font-size:clamp(5px,1.7vw,10px)}.overlay-form input:not([type="checkbox"]):focus{box-shadow:0 0 0 1px #168ee5}}
</style>
