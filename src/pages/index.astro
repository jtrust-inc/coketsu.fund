---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import LandingForm from '../components/LandingForm.astro';
import LandingFooter from '../components/LandingFooter.astro';
const page = { route:'/', file:'index.html', title:'COKETSU FUND｜少額から始める不動産クラウドファンディング', description:'COKETSU FUNDは、専門家とともに価値と未来を創造する不動産投資型クラウドファンディングです。無料資料請求・相談予約を受け付けています。', bodyClass:'lp-page component-lp', headAssets:'', beforeHeader:'', header:'', content:'', footer:'', afterFooter:'' };
const artwork = '/assets/lp/reference/';
const steps = ['資料請求・予約', '資料確認・ご相談', '契約手続き', '払込み・運用開始'];
---
<BaseLayout page={page}>
  <a class="skip-link" href="#main">本文へ移動</a>
  <div class="lp-shell">
    <LandingHeader />
    <main id="main" data-astro-migrated="true">
      <section class="hero" aria-labelledby="hero-heading">
        <h1 id="hero-heading" class="sr-only">不動産投資に、話せる安心を。仕組みもリスクも、担当者に相談して始める不動産小口投資。</h1>
        <img class="hero-photo" src={`${artwork}hero.png`} width="410" height="324" alt="不動産投資に、話せる安心を。担当者に相談する二人の投資家。" fetchpriority="high" />
        <div class="hero-form"><LandingForm id="consultation" /></div>
      </section>
      <section class="record" aria-label="運用実績">
        <img class="record-band" src={`${artwork}record-band.png`} width="762" height="78" alt="配当遅延0件、ファンド延長0件、元本毀損0件" />
        <p>※2026年9月30日時点の実績です。将来の運用成果を保証するものではありません。</p>
      </section>
      <section class="about pale-section" id="about" aria-labelledby="about-title">
        <h2 id="about-title">COKETSU FUNDとは</h2>
        <p class="intro">少額から始める、不動産クラウドファンディング。</p>
        <p>複数の投資家が共同で出資し、集まった資金で不動産を取得・運用。<br class="desktop-break" />賃料収入や売却益を、出資比率や契約内容に応じて分配する仕組みです。</p>
        <div class="metrics"><div><span>投資金額</span><p>1口 <strong>10</strong> 万円〜</p></div><div><span>お申込手数料</span><p><strong>0</strong> 円</p></div></div>
        <p class="explanation">COKETSU FUNDでは、投資家の皆様と株式会社ジェイトラストが<br class="desktop-break" />匿名組合契約に基づき共同出資し、物件の管理・運用は当社が担当します。</p>
        <p class="risk-note">※元本や分配金は保証されません。</p>
      </section>
      <section class="mechanism-section" id="mechanism" aria-labelledby="mechanism-title">
        <h2 id="mechanism-title" class="sr-only">出資から運用、分配までの仕組み</h2>
        <div class="diagram-scroll" tabindex="0" role="region" aria-label="出資・運用・分配の図解"><img src={`${artwork}mechanism.png`} width="762" height="152" loading="lazy" alt="投資家がCOKETSU FUNDに出資。COKETSU FUNDが不動産を取得・運用し、賃料収入・売却益を投資家へ分配します。元本や利益の保証はありません。" /></div>
        <a class="diagram-enlarge" href={`${artwork}mechanism.png`} target="_blank" rel="noopener">仕組みの図を拡大する</a>
      </section>
      <section class="funds" aria-labelledby="funds-title"><h2 id="funds-title">不動産プロジェクト</h2><div class="fund-grid">
        {[
          { name: '世田谷区深沢4丁目 土地1号プロジェクト', amount: '42,900,000' },
          { name: 'AZXIA BLD. 西麻布1号プロジェクト', amount: '63,600,000' },
        ].map(fund => <article class="fund-card">
          <div class="fund-visual"><img src={`${artwork}fund-cover.png`} width="312" height="67" loading="lazy" alt="COKETSU FUND 募集終了" /></div>
          <h3>{fund.name}</h3>
          <dl><div><dt>想定運用期間</dt><dd><strong>12</strong> ヶ月</dd></div><div><dt>募集金額</dt><dd>{fund.amount} 円</dd></div></dl>
        </article>)}
      </div><p class="risk-note">※実際の運用内容の詳細は、契約書等の記載事項をご確認ください。</p></section>
      <section class="operation pale-section" aria-labelledby="operation-title"><h2 id="operation-title">運用の仕組み</h2><div class="diagram-scroll" tabindex="0" role="region" aria-label="運用の仕組みの図解"><img src={`${artwork}operation.png`} width="610" height="195" loading="lazy" alt="投資家の優先出資とジェイトラストの劣後出資で対象不動産を取得。入居者からの賃料、売却による利益を原資に、投資家へ優先的に分配・償還します。" /></div><a class="diagram-enlarge" href={`${artwork}operation.png`} target="_blank" rel="noopener">運用の図を拡大する</a><p class="risk-note">賃料収入は投資家へ優先的に分配。償還時は投資家、事業者の順に出資金を返還します。分配・償還は契約内容に基づきます。</p></section>
      <section class="priority pale-section" aria-labelledby="priority-title"><h2 id="priority-title">優先劣後出資システムの仕組み</h2><p class="priority-intro">5,000万円の物件が500万円下落した場合の例</p><div class="diagram-scroll" tabindex="0" role="region" aria-label="優先劣後出資の図解"><img src={`${artwork}priority.png`} width="649" height="152" loading="lazy" alt="投資家の優先出資4,000万円（80%）、ジェイトラストの劣後出資1,000万円（20%）。不動産価格が4,500万円に下落した場合、ジェイトラストが500万円を負担し、お客様に4,000万円を償還する例。" /></div><a class="diagram-enlarge" href={`${artwork}priority.png`} target="_blank" rel="noopener">優先劣後出資の図を拡大する</a><p class="explanation">この例では、劣後出資の範囲内で下落幅を吸収します。</p><p class="risk-note">※説明用です。分配金は将来の収益によって変動します。元本や分配金を保証するものではありません。</p></section>
      <section class="flow-section" id="flow" aria-labelledby="flow-title"><h2 id="flow-title">ご相談から運用開始までの4ステップ</h2><ol>{steps.map((step,index) => <li><img src={`${artwork}flow-${index + 1}.png`} width="144" height="71" loading="lazy" alt={`${index + 1}. ${step}`} /></li>)}</ol></section>
      <section class="bottom-cta" aria-labelledby="bottom-title"><h2 id="bottom-title">仕組みも、リスクも。<br />まずはご相談ください。</h2><LandingForm id="consultation-bottom" compact /></section>
    </main>
    <LandingFooter />
  </div>
</BaseLayout>
<style>
  :global(html){scroll-behavior:smooth}:global(body.component-lp){margin:0;background:#fff;color:#166da4;font-family:'Yu Gothic','Hiragino Kaku Gothic ProN',Meiryo,sans-serif;line-height:1.6}:global(.component-lp *){box-sizing:border-box}:global(.component-lp img){max-width:100%}:global(.component-lp [id]){scroll-margin-top:12px}
  .lp-shell{width:min(100%,1200px);margin-inline:auto;container-type:inline-size}.skip-link{position:fixed;top:-80px;left:12px;padding:12px;background:#fff;z-index:100}.skip-link:focus{top:12px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}h2{font-family:'Yu Mincho','Hiragino Mincho ProN',serif;font-size:2.7cqw;font-weight:600;line-height:1.35;text-align:center;margin:0}p{margin:0}.hero{display:grid;grid-template-columns:54% 46%;background:#eaf8ff url('/assets/lp/reference/hero-edge.png') right center/4.2% 100% no-repeat;align-items:stretch}.hero-photo{display:block;width:100%;height:auto;align-self:end}.hero-form{padding:.6cqw 4.8cqw 1cqw 0;align-self:center;min-width:0}
  .record{padding:.8cqw 8.8cqw .85cqw;background:linear-gradient(110deg,#008cff,#005af0 60%,#00b7fb);color:#fff;text-align:center}.record-items{display:grid;grid-template-columns:repeat(3,1fr);gap:4cqw;justify-items:center}.record-items img{display:block;width:21.1cqw;height:auto}.record>p{font-size:1cqw;font-weight:600;line-height:1.5;margin-top:.25cqw}
  .pale-section{background:linear-gradient(110deg,#eaf9ff,#f8fdff 45%,#ebf9ff);text-align:center}.about{padding:1.1cqw 8cqw .6cqw;background-image:url('/assets/lp/reference/about-edge.png'),linear-gradient(110deg,#eaf9ff,#f8fdff 45%,#e5f7ff);background-position:left center;background-size:15.75% 100%,100% 100%;background-repeat:no-repeat;font-size:1.9cqw;font-weight:600;line-height:1.8}.about h2{font-size:2.9cqw;color:#1b668d;margin-bottom:.8cqw}.intro{font-family:'Yu Mincho',serif;font-size:2.1cqw;margin-bottom:.7cqw}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:2cqw;width:79%;margin:.8cqw auto}.metrics>div{background:linear-gradient(115deg,#0067d8,#004bac);color:#fff;border-radius:1cqw;padding:.3cqw .8cqw .5cqw;line-height:1.25}.metrics>div+div{background:#2eabea}.metrics span{font-size:1.5cqw}.metrics p{font-size:2cqw;font-weight:400}.metrics strong{font-family:Arial,sans-serif;font-size:4.3cqw;font-weight:300}.explanation{font-size:1.6cqw;line-height:1.8;font-weight:700}.risk-note{font-size:1.05cqw;line-height:1.6;text-align:center}.about .risk-note{margin-top:.3cqw}
  .mechanism-section{background:#0078ee}.diagram-scroll{overflow-x:auto;overscroll-behavior-x:contain}.diagram-scroll img{display:block;width:100%;height:auto}.funds{padding:.7cqw 7.5cqw .8cqw;background:#fff}.funds h2{margin-bottom:.4cqw}.fund-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.2cqw}.fund-grid article{min-width:0}.fund-grid img{display:block;width:100%;height:auto}.funds .risk-note{color:#555;font-size:.95cqw;margin-top:.35cqw}
  .operation{padding:1.1cqw 9.5cqw 1.2cqw}.operation h2{margin-bottom:.7cqw}.operation .risk-note{margin:1cqw -1.5cqw 0;color:#555;font-size:1.25cqw}.priority{padding:.4cqw 7.6cqw 1cqw;background:linear-gradient(115deg,#e9faff,#f9fdff 45%,#e5f7ff)}.priority h2{font-size:3cqw}.priority-intro{font-size:1.8cqw;font-weight:600;margin:.3cqw 0 .6cqw}.priority .explanation{margin-top:.4cqw}.priority .risk-note{font-size:1cqw;margin-top:.2cqw}
  .flow-section{padding:.6cqw 5.5cqw .8cqw;background:#fff}.flow-section h2{font-size:2.7cqw;color:#0056ff;margin-bottom:.5cqw}.flow-section ol{display:grid;grid-template-columns:repeat(4,1fr);gap:4cqw;list-style:none;padding:0;margin:0}.flow-section li{position:relative;min-width:0}.flow-section li+li:before{content:'›';position:absolute;left:-2.9cqw;top:25%;font-size:3.8cqw;color:#006aff}.flow-section img{display:block;width:100%;height:auto}
  .bottom-cta{display:grid;grid-template-columns:34% 62%;gap:2%;align-items:center;background:linear-gradient(115deg,#009ced,#0060ff 55%,#00a8f7);padding:1.1cqw 4.5cqw 1.1cqw 4.5cqw}.bottom-cta h2 img{display:block;width:100%;height:auto}
  @media(max-width:600px){h2,.about h2,.priority h2,.flow-section h2{font-size:23px}.hero{grid-template-columns:1fr;background:#ecf9ff}.hero-photo{width:100%}.hero-form{padding:16px;align-self:auto}.record{padding:12px 8px}.record-items{gap:6px}.record-items img{width:100%}.record>p{font-size:9px;margin-top:8px}.about{padding:24px 18px 18px;font-size:14px;line-height:1.8;background-size:25% 100%,100% 100%}.intro{font-size:17px;margin:12px 0}.desktop-break{display:none}.metrics{width:100%;gap:10px;margin:16px 0}.metrics>div{border-radius:6px;padding:10px 6px}.metrics span{font-size:12px}.metrics p{font-size:14px}.metrics strong{font-size:34px}.explanation{font-size:13px;line-height:1.9}.risk-note,.about .risk-note{font-size:11px;margin-top:10px}.diagram-scroll{scrollbar-width:thin}.diagram-scroll img{min-width:600px;max-width:none}.mechanism-section .diagram-scroll img{min-width:640px}.funds{padding:20px 18px}.funds h2{margin-bottom:14px}.fund-grid{grid-template-columns:1fr;gap:12px}.funds .risk-note{font-size:10px;margin-top:10px}.operation,.priority{padding:22px 16px}.operation h2{margin-bottom:14px}.operation .risk-note{margin:14px 0 0;font-size:11px}.priority-intro{font-size:13px;margin:10px 0 16px}.priority .explanation{margin-top:14px}.priority .risk-note{font-size:10px;margin-top:8px}.flow-section{padding:22px 16px}.flow-section h2{font-size:20px;margin-bottom:16px}.flow-section ol{grid-template-columns:1fr 1fr;gap:12px 24px}.flow-section li+li:before{display:none}.flow-section li:nth-child(even):before{display:block;left:-18px;top:22%;font-size:28px}.bottom-cta{grid-template-columns:1fr;gap:18px;padding:24px 16px}.bottom-cta h2{max-width:280px;margin-inline:auto}}
  .bottom-cta h2{font-size:2.8cqw;line-height:1.65;font-weight:400;color:#fff;text-align:left;white-space:nowrap}
  @media(max-width:600px){.bottom-cta h2{font-size:22px}}
  .diagram-enlarge{display:none}
  @media(max-width:600px){.diagram-scroll img,.mechanism-section .diagram-scroll img{min-width:0;max-width:100%}.diagram-enlarge{display:block;text-align:right;padding:8px 0;color:#1265a4;font-size:12px}.mechanism-section .diagram-enlarge{color:#fff;padding:8px 16px}}

  .fund-card{border:1px solid #ddd;border-radius:.6cqw;overflow:hidden;box-shadow:0 0 3px #0002;color:#333}.fund-visual{position:relative}.status{position:absolute;left:1cqw;top:.8cqw;padding:.1cqw .9cqw;border-radius:.5cqw;background:#0068ff;color:#fff;font-size:1.4cqw;font-weight:700}.fund-card h3{font-size:1.3cqw;line-height:1.5;margin:.7cqw 1.3cqw}.fund-card dl{display:grid;gap:.7cqw;padding:0 1.3cqw .8cqw;margin:0}.fund-card dl>div{display:flex;align-items:baseline;gap:1.4cqw}.fund-card dt{font-size:1cqw}.fund-card dd{margin:0;font-size:1.3cqw;font-weight:700}.fund-card dd strong{color:#0068ff;font-size:2.3cqw}
  @media(max-width:600px){.fund-card{border-radius:6px}.status{left:10px;top:8px;padding:2px 8px;font-size:12px}.fund-card h3{font-size:14px;margin:10px 12px}.fund-card dl{gap:8px;padding:0 12px 12px}.fund-card dl>div{gap:20px}.fund-card dt{font-size:12px}.fund-card dd{font-size:14px}.fund-card dd strong{font-size:20px}}


  .record{padding:0 0 .8cqw;background:#0088ee}.record-band{display:block;width:100%;height:auto}.record>p{margin:.2cqw 2cqw 0}
  .about{background-image:url('/assets/lp/reference/about-edge.png'),url('/assets/lp/reference/about-right-edge.png'),linear-gradient(110deg,#eaf9ff,#f8fdff 45%,#e5f7ff);background-position:left center,right center,center;background-size:15.75% 100%,8.14% 100%,100% 100%;background-repeat:no-repeat}.hero-form{align-self:start;padding-top:.8cqw}
  @media(max-width:600px){.record{padding-bottom:10px}.record>p{margin:6px 12px 0}.hero-form{padding:16px}}
</style>
