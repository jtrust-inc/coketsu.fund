---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCapturedPages, type CapturedPage } from "../lib/site";
export async function getStaticPaths() {
  const pages = await getCapturedPages();
  return pages.map((page) => ({ params: { slug: page.route === "/" ? undefined : page.route.replace(/^\//, "").replace(/\/$/, "") }, props: { page } }));
}
interface Props { page: CapturedPage }
const { page } = Astro.props;
---
<BaseLayout page={page}>
  <Fragment set:html={page.beforeHeader} /><SiteHeader html={page.header} />
  <main id="main" data-astro-migrated="true"><Fragment set:html={page.content} /></main>
  <SiteFooter html={page.footer} /><Fragment set:html={page.afterFooter} />
</BaseLayout>
