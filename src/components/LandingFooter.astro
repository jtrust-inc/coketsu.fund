---
import { readFileSync } from 'node:fs';
const captured = readFileSync(new URL('../../migration-source/site/index.html', import.meta.url), 'utf8');
const plain = (value: string) => value.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').trim();
const faqs = [...captured.matchAll(/<dl class="vk_faq-body">([\s\S]*?)<\/dl>/g)].map(([, block]) => ({
  question: plain(block.match(/<dt\b[^>]*>([\s\S]*?)<\/dt>/)?.[1] || ''),
  answer: plain(block.match(/<dd\b[^>]*>([\s\S]*?)<\/dd>/)?.[1] || ''),
})).filter(item => item.question && item.answer);
---
<footer class="landing-footer">
  <div class="footer-top"><a href="/" class="footer-brand">COKETSU FUND</a><nav aria-label="フッターナビゲーション"><a href="/news/">NEWS</a><button type="button" data-faq-open>よくある質問</button><a href="/contact/">お問い合わせ</a><a href="https://jtrust-inc.jp/">運営会社</a></nav></div>
  <div class="footer-body"><address>運営会社：株式会社ジェイトラスト<br />宅地建物取引業免許：国土交通大臣（2）第10041号<br />賃貸住宅管理業者登録：国土交通大臣（01）第005921号<br />不動産特定共同事業：東京都知事 第182号<br />代表者：松本 圭貴<br />本社：〒103-0013 東京都中央区日本橋人形町1-19-5 エムズクロス人形町10F<br />電話番号（代表）：<a href="tel:0366906844">03-6690-6844</a></address><div class="footer-risk"><p>投資には元本割れ等のリスクがあります。<br />契約内容・リスクをご確認ください。</p><small>© COKETSU FUND</small></div></div>
  <nav class="legal-links" aria-label="法定情報"><a href="/privacy-policy/">プライバシーポリシー</a><a href="/cooling-off/">クーリング・オフ</a></nav>
</footer>
<dialog id="faq-dialog" aria-labelledby="faq-title"><button class="close" type="button" data-faq-close aria-label="よくある質問を閉じる">閉じる ×</button><h2 id="faq-title">よくある質問</h2>{faqs.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#faq-dialog');
  document.querySelector('[data-faq-open]')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('[data-faq-close]')?.addEventListener('click', () => dialog?.close());
</script>
<style>
  .landing-footer{padding:1.4cqw 4.6cqw 4cqw;background:radial-gradient(at 25% 0,#084b82,#002653 65%);color:#fff}.footer-top{display:flex;align-items:center;justify-content:space-between;padding-bottom:.6cqw;border-bottom:1px solid #81a1bd}.footer-brand{font-size:2.6cqw;letter-spacing:.04em;line-height:1.3;font-family:Arial,sans-serif}.footer-top nav{display:flex;gap:0;align-items:center;font-size:1.2cqw}.footer-top nav>*{padding:0 1.7cqw;border-right:1px solid #fff;background:none;color:inherit;font:inherit;cursor:pointer}.footer-top nav>*:last-child{padding-right:0;border:0}a{color:inherit;text-decoration:none}button{border:0}.footer-body{display:grid;grid-template-columns:65% 35%;margin-top:1.2cqw;gap:0}address{font-style:normal;font-size:1.4cqw;line-height:1.55}.footer-risk{padding:0 0 0 2.5cqw;border-left:1px solid #98b4ca;display:flex;flex-direction:column;justify-content:space-between;font-size:1.3cqw}.footer-risk p{margin:0}.footer-risk small{text-align:right;font-size:1.3cqw}
  dialog{max-width:min(720px,calc(100vw - 24px));max-height:85dvh;padding:24px;border:1px solid #cbeaff;border-radius:8px;color:#174d72}dialog::backdrop{background:#00244299}dialog details{border-bottom:1px solid #d5e7ef;padding:14px 0}dialog summary{font-weight:700;cursor:pointer}dialog p{line-height:1.8}.close{display:block;margin-left:auto;padding:10px 16px;color:#fff;background:#0068ff;border-radius:5px;cursor:pointer}
  @media(max-width:600px){.landing-footer{padding:24px 18px}.footer-top{display:block;padding-bottom:14px}.footer-brand{font-size:24px}.footer-top nav{font-size:11px;flex-wrap:wrap;margin-top:14px;gap:8px}.footer-top nav>*{padding:4px 10px}.footer-body{grid-template-columns:1fr;margin-top:16px;gap:18px}address{font-size:11px;line-height:1.8}.footer-risk{border-left:0;border-top:1px solid #81a1bd;padding:16px 0 0;font-size:12px;gap:24px}.footer-risk small{font-size:11px}}
</style>
<style>
  .legal-links{display:flex;gap:16px;flex-wrap:wrap;margin-top:12px;font-size:10px}.legal-links a{text-decoration:underline}
</style>
