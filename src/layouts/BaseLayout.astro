---
import type { CapturedPage } from "../lib/site";
interface Props { page: CapturedPage }
const { page } = Astro.props;
const productionUrl = new URL(page.route, "https://coketsu.fund/").href;
const preview = Astro.url.hostname.endsWith(".workers.dev") || Astro.url.hostname === "localhost";
const hasForm = ["/", "/contact/", "/request/", "/institutional-step1/"].includes(page.route);
const description = page.description || "Coketsu fund. 専門家とともに価値と未来を創造する不動産投資型クラウドファンディング。";
// These identifiers are intentionally public: they are emitted into every page's HTML.
// Environment variables remain available for controlled overrides in other deployments.
const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || "G-17L9BLTJQT";
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "LB57brXbo1MTmIKTpQPRq6XWfE3MMLmpsc6upGlDOaM";
const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "Organization", "@id": "https://coketsu.fund/#organization", name: "株式会社COKETSU", url: "https://coketsu.fund/", logo: "https://coketsu.fund/wp-content/uploads/2025/04/coketsu2.png", contactPoint: { "@type": "ContactPoint", url: "https://coketsu.fund/contact/", contactType: "customer support", availableLanguage: "Japanese" } },
  { "@type": "WebSite", "@id": "https://coketsu.fund/#website", name: "Coketsu fund.", url: "https://coketsu.fund/", publisher: { "@id": "https://coketsu.fund/#organization" } },
  { "@type": "WebPage", "@id": `${productionUrl}#webpage`, url: productionUrl, name: page.title, description, inLanguage: "ja", isPartOf: { "@id": "https://coketsu.fund/#website" } },
  { "@type": "BreadcrumbList", itemListElement: page.route === "/" ? [{ "@type": "ListItem", position: 1, name: "ホーム", item: "https://coketsu.fund/" }] : [{ "@type": "ListItem", position: 1, name: "ホーム", item: "https://coketsu.fund/" }, { "@type": "ListItem", position: 2, name: page.title, item: productionUrl }] },
] };
---
<!doctype html>
<html lang="ja"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{page.title}</title><meta name="description" content={description} />
  <meta name="robots" content={preview ? "noindex, nofollow" : "index, follow"} />
  <link rel="canonical" href={productionUrl} />
  <meta property="og:type" content={page.route === "/" ? "website" : "article"} /><meta property="og:site_name" content="Coketsu fund." />
  <meta property="og:url" content={productionUrl} /><meta property="og:title" content={page.title} /><meta property="og:description" content={description} />
  <meta property="og:image" content="https://coketsu.fund/wp-content/uploads/2025/04/coketsu2.png" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={page.title} /><meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://coketsu.fund/wp-content/uploads/2025/04/coketsu2.png" />
  {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
  <link rel="icon" href="/wp-content/uploads/2025/04/cropped-favicon_coketsu-32x32.png" sizes="32x32" />
  <Fragment set:html={page.headAssets} /><script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {ga4MeasurementId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>}
  {ga4MeasurementId && <script is:inline define:vars={{ ga4MeasurementId }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag("js",new Date());gtag("config",ga4MeasurementId,{anonymize_ip:true});</script>}
  {hasForm && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  {hasForm && <script src="/form-handler.js" defer></script>}
  <style is:inline>
    .astro-form-status{min-height:1.5em;margin:1rem 0;color:#17384c;font-weight:600}.astro-honeypot{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}.cf-turnstile{margin:1.25rem 0}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #005fcc;outline-offset:3px}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
  </style>
</head><body class={page.bodyClass}><slot /></body></html>
