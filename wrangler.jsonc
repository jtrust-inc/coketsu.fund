{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coketsu-fund",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
