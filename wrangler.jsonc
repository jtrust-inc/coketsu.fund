{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coketsu-fund",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "61472",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
